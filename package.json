{
  "name": "bluconnet-b2b-platform",
  "version": "1.0.0",
  "description": "B2B Lead Management Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "start": "node server/dist/index.js",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "prisma:generate": "npm run prisma:generate --prefix server",
    "prisma:migrate": "npm run prisma:migrate --prefix server",
    "prisma:seed": "npm run prisma:seed --prefix server"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
