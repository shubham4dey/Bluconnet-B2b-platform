{
  "version": 2,
  "buildCommand": "cd server && npm install && npm run build && cd ../client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "public": true,
  "env": {
    "PORT": "4000",
    "NODE_ENV": "production"
  },
  "builds": [
    {
      "src": "server/package.json",
      "use": "@vercel/node",
      "config": {
        "zeroConfig": true,
        "includeFiles": "server/dist/**"
      }
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "npm run build",
        "outputDirectory": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/src/index.ts",
      "methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH",
        "OPTIONS"
      ]
    },
    {
      "src": "/(.*)",
      "dest": "client/dist/index.html",
      "status": 200
    }
  ],
  "regions": ["iad1"],
  "functions": {
    "server/src/index.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "runtime": "nodejs18.x"
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- client/ server/ package.json vercel.json"
}
